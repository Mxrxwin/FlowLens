REDIS_ADDR=redis:6379

POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=monitoring
DATABASE_URL=postgres://user:password@postgres:5432/monitoring?sslmode=disable

FLOWLENS_BACKEND_PORT=8081
FLOWLENS_HTTP_PORT=5173
FLOWLENS_PROJECT_KEYS=pk_demo

VITE_API_URL=

# ---------------------------------------------------------------------------
# Optional: server-side GeoIP enrichment (MaxMind GeoLite2-City).
# When disabled, FlowLens uses SDK hint → CDN/proxy headers → "Unresolved region".
# No network calls happen on the /ingest hot path either way.
# ---------------------------------------------------------------------------
# FLOWLENS_GEOIP_ENABLED=false
# FLOWLENS_GEOIP_DB_PATH=/geoip/GeoLite2-City.mmdb
# FLOWLENS_STORE_IP=false

# Credentials for the optional `geoip-updater` service (docker compose profile
# "geoip"). Sign up at https://www.maxmind.com/en/geolite2/signup to get them.
# Leave blank to keep the updater out of `docker compose up`.
# MAXMIND_ACCOUNT_ID=
# MAXMIND_LICENSE_KEY=
